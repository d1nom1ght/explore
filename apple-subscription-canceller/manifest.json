{
  "manifest_version": 3,
  "name": "Apple Abonnement Kündigen",
  "version": "1.0",
  "description": "Öffnet direkt die Apple-Abonnementverwaltung zum einfachen Kündigen.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://appleid.apple.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://appleid.apple.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
